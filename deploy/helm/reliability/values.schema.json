{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "persistence", "resources", "service", "networkPolicy",
               "podDisruptionBudget", "configReader", "observability", "existingOperatorSecret"],
  "properties": {
    "replicaCount": {"type": "integer", "enum": [1]},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "digest", "requireDigest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "requireDigest": {"type": "boolean"},
        "pullPolicy": {"enum": ["Never", "IfNotPresent", "Always"]}
      }
    },
    "persistence": {
      "type": "object", "additionalProperties": false,
      "required": ["size", "storageClass", "existingClaim", "retain"],
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "storageClass": {"type": "string"},
        "existingClaim": {"type": "string"},
        "retain": {"type": "boolean"}
      }
    },
    "resources": {"type": "object", "required": ["requests", "limits"]},
    "service": {
      "type": "object", "additionalProperties": false,
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "allowedNamespaces": {"type": "array", "uniqueItems": true, "items": {
          "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        }}
      }
    },
    "podDisruptionBudget": {
      "type": "object", "additionalProperties": false,
      "properties": {"minAvailable": {"type": "integer", "enum": [0, 1]}}
    },
    "configReader": {
      "type": "object", "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    },
    "observability": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "apiSlo": {"type": "string", "pattern": "^0\\.[0-9]*[1-9][0-9]*$"},
        "maintenanceSlo": {"type": "string", "pattern": "^0\\.[0-9]*[1-9][0-9]*$"},
        "recoverySlo": {"type": "string", "pattern": "^0\\.[0-9]*[1-9][0-9]*$"},
        "recoveryDeadlineSeconds": {"type": "string", "pattern": "^[1-9][0-9]{0,2}$"}
      }
    },
    "existingOperatorSecret": {"type": "string"}
  }
}
