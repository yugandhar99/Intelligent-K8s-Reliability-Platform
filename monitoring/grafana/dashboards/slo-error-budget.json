{
  "uid": "slo-error-budget",
  "title": "SLO and Error Budget Monitoring",
  "description": "Observed objectives, error budgets, API traffic and latency.", 
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "Reliability",
    "Local lab"
  ],
  "refresh": "10s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Measurement mode",
        "type": "custom",
        "query": "simulation,kubernetes",
        "includeAll": true,
        "allValue": "simulation|kubernetes",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API availability",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(reliability:sli_ratio:rate1h{mode=~\"$mode\",slo=\"api\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Maintenance reliability",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(reliability:sli_ratio:rate1h{mode=~\"$mode\",slo=\"maintenance\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Recovery within deadline",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(reliability:sli_ratio:rate1h{mode=~\"$mode\",slo=\"recovery\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "API latency p95",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(reliability:api_latency_p95_seconds:rate5m{mode=~\"$mode\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Observed SLIs",
      "description": "Ratios are absent when the evaluation window has zero observed events.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reliability:sli_ratio:rate1h{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} {{slo}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Error budget remaining",
      "description": "A negative value shows that observed bad events exceeded the configured allowance.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reliability:error_budget_remaining_ratio:rate1h{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} {{slo}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "API requests and failures per second",
      "description": "Routes are recorded as stable FastAPI templates.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (rate(reliability_http_requests_total{mode=~\"$mode\"}[5m]))",
          "legendFormat": "{{mode}} all",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (mode) (rate(reliability_http_requests_total{mode=~\"$mode\",status_class=\"5xx\"}[5m]))",
          "legendFormat": "{{mode}} 5xx",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "API latency percentiles",
      "description": "Percentiles are estimated from Prometheus histogram buckets.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5,sum by (mode,le)(rate(reliability_http_request_duration_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "{{mode}} p50",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by (mode,le)(rate(reliability_http_request_duration_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "{{mode}} p95",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99,sum by (mode,le)(rate(reliability_http_request_duration_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "{{mode}} p99",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
