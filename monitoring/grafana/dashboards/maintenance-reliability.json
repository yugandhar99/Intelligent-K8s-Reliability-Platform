{
  "uid": "maintenance-reliability",
  "title": "Maintenance Operations and Reliability",
  "description": "Work queue, execution latency, evictions and worker recovery.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "Reliability",
    "Local lab"
  ],
  "refresh": "10s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Measurement mode",
        "type": "custom",
        "query": "simulation,kubernetes",
        "includeAll": true,
        "allValue": "simulation|kubernetes",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active jobs",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_jobs{mode=~\"$mode\",state=~\"queued|running|retrying\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Completed jobs",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_jobs{mode=~\"$mode\",state=\"succeeded\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Healthy workers",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_workers_healthy{mode=~\"$mode\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Expired leases",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_expired_leases_total{mode=~\"$mode\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Durable job state",
      "description": "Counts are reconstructed from SQLite.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode,state) (reliability_jobs{mode=~\"$mode\",state!=\"cancelled\"})",
          "legendFormat": "{{mode}} {{state}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Job duration p95",
      "description": "Wall time from queue admission to a terminal state.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (mode,le)(rate(reliability_job_duration_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "{{mode}} p95",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Eviction outcomes and retries",
      "description": "A blocked live eviction is a PDB response and contributes to the alert signal.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode,outcome) (reliability_eviction_attempts_total{mode=~\"$mode\"})",
          "legendFormat": "{{mode}} {{outcome}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "reliability_eviction_retries_total{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} retry decisions",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Worker leases and backlog",
      "description": "Worker counts expire when a heartbeat stops updating its lease.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reliability_workers_healthy{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} healthy workers",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "reliability_leases_overdue{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} overdue leases",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
