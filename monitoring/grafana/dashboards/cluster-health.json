{
  "uid": "cluster-health",
  "title": "Kubernetes Cluster Health",
  "description": "Live Kind health and simulator state with explicit measurement mode.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "Reliability",
    "Local lab"
  ],
  "refresh": "10s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Measurement mode",
        "type": "custom",
        "query": "simulation,kubernetes",
        "includeAll": true,
        "allValue": "simulation|kubernetes",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Live ready workers",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_cluster_nodes{role=\"worker\",state=\"ready\",mode=\"kubernetes\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Live ready application replicas",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_application_replicas{state=\"ready\",mode=\"kubernetes\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Live PDB violations",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_pdb_violations{mode=\"kubernetes\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Live runtime samples",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(reliability_runtime_metrics_available{mode=\"kubernetes\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool_yes_no",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Nodes by readiness",
      "description": "Worker and control-plane groups have bounded series.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reliability_cluster_nodes{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} {{role}} {{state}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Replica readiness",
      "description": "Live counts come from the lab Deployment status.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reliability_application_replicas{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} {{state}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Worker resource fractions",
      "description": "Runtime usage appears when metrics-server reports every worker. Requests use allocatable capacity.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reliability_cluster_resource_ratio{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} {{resource}} {{source}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Disruption safety",
      "description": "A violation means observed healthy replicas are below the budget minimum.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reliability_pdb_violations{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} violations",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "reliability_pdb_zero_slack{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} zero slack",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
