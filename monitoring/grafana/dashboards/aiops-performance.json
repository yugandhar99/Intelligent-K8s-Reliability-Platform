{
  "uid": "aiops-performance",
  "title": "AIOps and AI Provider Performance",
  "description": "Incident lifecycle, provider behavior, spending and human decisions.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "Reliability",
    "Local lab"
  ],
  "refresh": "10s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Measurement mode",
        "type": "custom",
        "query": "simulation,kubernetes",
        "includeAll": true,
        "allValue": "simulation|kubernetes",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Open incidents",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_incidents{mode=~\"$mode\",state=\"open\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Resolved incidents",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_incidents{mode=~\"$mode\",state=\"resolved\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "AI accounted cost today",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_ai_cost_today_dollars{mode=~\"$mode\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Rejected approvals",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(reliability_approval_rejections_total{mode=~\"$mode\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Provider p95 latency",
      "description": "Provider call latency includes failed attempts.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (mode,provider,le)(rate(reliability_ai_attempt_duration_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "{{mode}} {{provider}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Provider calls and failures",
      "description": "Mock is local. Optional external provider calls appear after use.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode,provider,outcome)(reliability_ai_attempt_duration_seconds_count{mode=~\"$mode\",provider=\"mock\"})",
          "legendFormat": "{{mode}} {{provider}} {{outcome}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (mode,provider,outcome)(reliability_ai_attempt_duration_seconds_count{mode=~\"$mode\",provider!=\"mock\"}) > 0",
          "legendFormat": "{{mode}} {{provider}} {{outcome}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Incident and approval p95",
      "description": "Incident durations start at the first observed symptom.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (mode,phase,le)(rate(reliability_incident_duration_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "{{mode}} {{phase}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by (mode,le)(rate(reliability_aiops_approval_duration_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "{{mode}} approval",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "UTC-day token ledger",
      "description": "The default mock provider incurs zero billable tokens.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "reliability-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reliability_ai_tokens_today{mode=~\"$mode\"}",
          "legendFormat": "{{mode}} {{provider}} {{direction}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "reliability-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 16,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
